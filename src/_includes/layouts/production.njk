---
layout: layouts/base.njk
---

<article class="pt-24">
  <div class="max-w-4xl mx-auto px-4 py-16">
    {# Back link #}
    <a href="{{ '/season/' | url }}" class="inline-flex items-center gap-2 text-ntc-gold hover:text-ntc-gold-light mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Season
    </a>

    {# Production header #}
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-display text-ntc-gold mb-4">{{ title }}</h1>
      {% if category %}
      <p class="text-xl text-ntc-white/80">{{ category }}</p>
      {% endif %}
      {% if date %}
      <time datetime="{{ date | isoDate }}" class="text-sm text-ntc-white/60">
        {{ date | readableDate }}
      </time>
      {% endif %}
    </header>

    {# Featured image #}
    {% if image %}
    <figure class="mb-12">
      <div class="relative overflow-hidden rounded-lg gold-border">
        <img
          src="{{ image | url }}"
          alt="{{ imageAlt | default(title) }}"
          class="w-full aspect-video object-cover"
        >
      </div>
    </figure>
    {% endif %}

    {# Content #}
    <div class="prose prose-invert prose-gold max-w-none">
      {{ content | safe }}
    </div>
  </div>
</article>
