<header class="fixed w-full z-50 bg-ntc-black/95 gold-border border-t-0 border-x-0" data-controller="mobile-nav">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-24 items-center">
      {# Logo #}
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-4">
          <img src="{{ '/assets/images/ntc-logo.webp' | url }}" alt="{{ site.name }}" class="h-16 w-auto logo-shadow">
        </a>
      </div>

      {# Desktop Navigation #}
      <ul class="hidden md:flex items-center space-x-8">
        {% for item in navigation.main %}
        <li>
          <a
            href="{{ item.url }}"
            class="{% if page.url == item.url %}text-ntc-gold{% else %}text-ntc-white{% endif %} hover:text-ntc-gold-light transition-colors"
          >
            {{ item.label }}
          </a>
        </li>
        {% endfor %}
      </ul>

      {# Mobile Menu Button #}
      <button
        type="button"
        class="md:hidden p-2 -mr-2 text-ntc-gold"
        data-action="click->mobile-nav#toggle"
        data-mobile-nav-target="button"
        aria-expanded="false"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" data-mobile-nav-target="iconOpen" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 hidden" data-mobile-nav-target="iconClose" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {# Mobile Navigation #}
    <div data-mobile-nav-target="menu" class="hidden md:hidden pb-4">
      <ul class="flex flex-col space-y-2">
        {% for item in navigation.main %}
        <li>
          <a
            href="{{ item.url }}"
            class="block py-2 {% if page.url == item.url %}text-ntc-gold{% else %}text-ntc-white{% endif %} hover:text-ntc-gold-light transition-colors"
          >
            {{ item.label }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>
